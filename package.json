{
  "name": "xiuxian-character-appearance-creator",
  "version": "0.1.0",
  "private": true,
  "description": "2D 修仙角色外观编辑器",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @xiuxian/editor dev",
    "typecheck": "pnpm --filter @xiuxian/editor typecheck",
    "check:assets": "pnpm --filter @xiuxian/character-assets build",
    "build": "pnpm --filter @xiuxian/editor build",
    "preview": "pnpm --filter @xiuxian/editor preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "simple-git-hooks",
    "pack:assets": "pnpm check:assets && uv run --locked python scripts/pack-assets.py",
    "refs:assets": "pnpm check:assets && uv run --locked python scripts/pack-assets.py --refresh-references",
    "test": "pnpm --filter @xiuxian/editor test && uv run --locked python -m unittest discover -s scripts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "ajv": "^8.20.0",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"${1}\""
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,html,css,scss,md,yml,yaml,toml}": [
      "oxfmt"
    ],
    "*.py": [
      "uv run --locked ruff check --fix",
      "uv run --locked ruff format"
    ]
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.21.0"
}
